<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- 直接链接 Core 源文件：单测不触碰 Unity / 游戏程序集 -->
    <Compile Include="../../src/DeathRewind/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 Mod 内嵌的是同一份 WAV：单测直接验证这段音频能被解码器正确还原 -->
    <EmbeddedResource Include="../../src/DeathRewind/Audio/oneup.wav" LogicalName="DeathRewind.Tests.oneup.wav" />
  </ItemGroup>
</Project>
